<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icd="clr-namespace:FrameWork.Controls;assembly=FrameWork.Controls"
    xmlns:local="clr-namespace:FrameWork.Resources"
    >
    <!--icd 선선을 해줌으로서 컨트롤에서 바인딩 될수있게한다-->
    <ResourceDictionary.MergedDictionaries>
        <!--리소스를 추가해준다
        <ResourceDictionary Source="Color.xaml"/>
        -->
        <ResourceDictionary Source="Controls/Button.xaml"/>
        <ResourceDictionary Source="Controls/CheckBox.xaml"/>
        <ResourceDictionary Source="Controls/ComboBox.xaml"/>
        <ResourceDictionary Source="Controls/ComboBoxItem.xaml"/>
        <ResourceDictionary Source="Controls/DataGrid.xaml"/>
        <ResourceDictionary Source="Controls/DatePicker.xaml"/>
        <ResourceDictionary Source="Controls/Expander.xaml"/>
        <ResourceDictionary Source="Controls/Label.xaml"/>
        <ResourceDictionary Source="Controls/NumericTextBox.xaml"/>
        <ResourceDictionary Source="Controls/RadioButton.xaml"/>
        <ResourceDictionary Source="Controls/TabControl.xaml"/>
        <ResourceDictionary Source="Controls/TabItem.xaml"/>
        <ResourceDictionary Source="Controls/TabItemEx.xaml"/>
        <ResourceDictionary Source="Controls/TextBox.xaml"/>
        <ResourceDictionary Source="Controls/TitleMain.xaml"/>
        <ResourceDictionary Source="Controls/TitleSub.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Label Style
    <Style TargetType="{x:Type icd:Label}">
        <Setter Property="Foreground" Value="#FF142c45" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="1,1,0,0" />
        <Setter Property="FontFamily" Value="Malgun Gothic" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icd:Label}">
                    <Grid >
                        <Border  Background="#FFD6E8FF"/>
                        <StackPanel x:Name="stackPanel" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="10,0,10,0" >
                            <Ellipse Fill="#FFdd00" x:Name="textBlock" VerticalAlignment="center"  Width="3.2" Height="3.2" Visibility="Collapsed" Margin="0,0,6,0"/>
                            <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding Content}"   />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Required">
                            <Setter Property="Visibility" TargetName="textBlock" Value="Visible"/>
                            <Setter Property="Margin" TargetName="textBlock" Value="0,0,4,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type icd:TextBox}" >
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontName}"/>
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Width" Value="353"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Color_Black}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color_3399FF}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="InputMethod.PreferredImeState" Value="On" />
        <Setter Property="InputMethod.PreferredImeConversionMode" Value="Native" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icd:TextBox}">
                    <Grid>
                        <Border Name="Border" CornerRadius="4" Padding="0" Background="{StaticResource Color_White}" BorderBrush="{TemplateBinding BorderBrush }" BorderThickness="{TemplateBinding BorderThickness }" >
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <Label x:Name="InternalWatermarkLabel" Padding="10,0,10,0" HorizontalContentAlignment="Left"  VerticalContentAlignment="Center" FontSize="12" FontFamily="{StaticResource FontName}" Content="{TemplateBinding Tag}" Visibility="Collapsed" Focusable="False" Foreground="Silver" Background="Transparent" />
                    </Grid>

                    <ControlTemplate.Triggers >
                        <MultiTrigger >
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter Property="Visibility" TargetName="InternalWatermarkLabel"
                                        Value="Visible" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False" >
                            <Setter Property="TextElement.Foreground"
                                    Value="{StaticResource Color_3399FF}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>
    -->
</ResourceDictionary>