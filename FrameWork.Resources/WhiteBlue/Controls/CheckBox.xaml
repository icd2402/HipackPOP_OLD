<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icd="clr-namespace:FrameWork.Controls;assembly=FrameWork.Controls" 
    >
    <!--icd 선선을 해줌으로서 컨트롤에서 바인딩 될수있게한다-->
    <ResourceDictionary.MergedDictionaries>
        <!--리소스를 추가해준다-->
        <ResourceDictionary Source="../Color.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Button Style-->
    <Style TargetType="{x:Type icd:CheckBox}">
        <Setter Property="Foreground" Value="#FF142c45" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="1,1,0,0" />
        <Setter Property="FontFamily" Value="Malgun Gothic" />
        <Setter Property="Template">

            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icd:CheckBox}">
                    <!--
                    <Grid >
                        
                        <Border  Background="#6799FF"/>
                        <StackPanel x:Name="stackPanel" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="10,0,10,0" >
                            <Ellipse Fill="#FFdd00" x:Name="textBlock" VerticalAlignment="center"  Width="3.2" Height="3.2" Visibility="Collapsed" Margin="0,0,6,0"/>
                            <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding Content}"   />
                        </StackPanel>
                        
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Required">
                            <Setter Property="Visibility" TargetName="textBlock" Value="Visible"/>
                            <Setter Property="Margin" TargetName="textBlock" Value="0,0,4,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    -->
                </ControlTemplate>
            </Setter.Value>

        </Setter>
    </Style>
</ResourceDictionary>