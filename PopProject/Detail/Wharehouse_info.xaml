<Window x:Class="PopProject.Detail.Wharehouse_info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Detail" 
        mc:Ignorable="d"
        Title="Wharehouse_info" Height="905" Width="1160" MaxHeight="905" MaxWidth="1160" WindowStyle ="None" ResizeMode="CanResizeWithGrip" SnapsToDevicePixels="True" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Label" x:Key="공정Label">
            <Setter Property="HorizontalContentAlignment" Value="Center"  />
            <Setter Property="VerticalContentAlignment"  Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center"  />
            <Setter Property="VerticalAlignment"  Value="Center" />
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"  />
            <Setter Property="Foreground" Value="#707070" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="명세서ListViewItem" TargetType="ListViewItem" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ViewPanel" BorderThickness="0,1,0,0" Margin="0,-1,0,0" BorderBrush="#CECECE" >
                            <ContentPresenter />
                            
                        </Border>
                        <ControlTemplate.Triggers >
                            <Trigger Property="IsSelected" Value="True" >
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter TargetName="ViewPanel"  Property="Background" Value="#EAF5FF"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter TargetName="ViewPanel" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="공정ListView" TargetType="ListView" >
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="#CECECE"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"  Value="Disabled" />
        <Setter Property="SelectionMode" Value="Single" />
           
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
        </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions >
            <RowDefinition Height="35"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="Black" MouseLeftButtonDown="drag_move">
            <TextBlock Margin="20,0,0,0" Text="박스 적재 창고 현황" Foreground="White" VerticalAlignment="Center" FontSize="20"></TextBlock>
            
        </Border>

        <DockPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" LastChildFill="False" >
            
            <Border Width="30" Height="30" Background="#BBF2FF"></Border>
            <TextBlock Text="적재 가능" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Width="30" Height="30" Background="#FF385DAB" Margin="10,0,0,0"></Border>
            <TextBlock Text="적재 불가" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Canvas.Left="55" Width="1" Height="90" Margin="10,0,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0"></Border>

            <TextBlock Text="거래처 : " FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="customName" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Canvas.Left="55" Width="1" Height="90" Margin="10,0,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0"></Border>

            <TextBlock Text="품명 : " FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="prodName" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Canvas.Left="55" Width="1" Height="90" Margin="10,0,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0"></Border>

            <TextBlock Text="생산 수량 : " FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="pworkCount" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border Canvas.Left="55" Width="1" Height="90" Margin="10,0,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0"></Border>
            <TextBlock Text="적재 위치 : " FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="LocationName" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>
        <TextBlock Text="X" Foreground="White" FontSize="25" VerticalAlignment="Center" Grid.Column="2" HorizontalAlignment="Center" MouseLeftButtonDown="exit"></TextBlock>
        <Border Grid.Row="2" Grid.Column="1" BorderThickness="3" Width="auto" Height="auto" VerticalAlignment="Stretch" BorderBrush="Black" Padding="5,5" Margin="0" HorizontalAlignment="Stretch"    >
            <ListView   ScrollViewer.VerticalScrollBarVisibility="Visible" x:Name="적재창고_ItemList" Style="{StaticResource 공정ListView}"  ItemContainerStyle="{StaticResource 명세서ListViewItem}"  BorderThickness="0" Background="Transparent" Validation.ErrorTemplate="{x:Null}">
                <ListView.ItemsPanel >
                    <ItemsPanelTemplate >
                        <StackPanel Orientation="Vertical" Margin="10, 0"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate >
                    <DataTemplate >
                        <ListView ScrollViewer.HorizontalScrollBarVisibility="Visible"    Margin="0,20,0,20" Height="120" ItemsSource="{Binding 적재구역_ItemList}"  Style="{StaticResource 공정ListView}"   ItemContainerStyle="{StaticResource 명세서ListViewItem}" BorderThickness="0" Background="Transparent" Validation.ErrorTemplate="{x:Null}" >
                            <ListView.ItemsPanel >
                                <ItemsPanelTemplate >
                                    <StackPanel Orientation="Horizontal" Margin="0"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate >
                                <DataTemplate >
                                    <Border x:Name="구역Border" BorderThickness="1" BorderBrush="LightGray" Width="60" CornerRadius="4" Padding="5, 0" Margin="5,0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF385DAB"  MouseLeftButtonDown="mouseLeftDown"  >
                                        <Label x:Name="구역" Style="{StaticResource 공정Label}" TextBlock.TextAlignment="Center"  Content="{Binding LocationNameDisplay}" Margin="0" Padding="0" Height="40" Foreground="White"  />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LocationType}" Value="0" >
                                            <Setter TargetName="구역Border" Property="Background" Value="#BBF2FF"/>
                                            <Setter TargetName="구역" Property="Foreground" Value="#707070" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LocationType}" Value="1" >
                                            <Setter TargetName="구역Border" Property="Background" Value="#FF385DAB"/>
                                            <Setter TargetName="구역" Property="Foreground" Value="#707070" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectedStyle}" Value="0">
                                            <Setter TargetName="구역Border" Property="BorderBrush" Value="LightGray" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectedStyle}" Value="1">
                                            <Setter TargetName="구역Border" Property="BorderBrush" Value="#FF42AA6B" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

    </Grid>
    
    
</Window>
