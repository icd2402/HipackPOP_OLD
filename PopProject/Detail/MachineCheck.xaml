        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Detail"
        mc:Ignorable="d"
        Title="MachineCheck" Height="400" Width="700" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#DAE3F3" Closed="closed">
    <Canvas>

        <TextBlock  Canvas.Left="10" Canvas.Top="1" x:Name="tb3" Text="" FontFamily="/font/#KoPubDotum Bold" FontSize="40" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Drag" Height="74" Width="606"  />

        <Image Canvas.Left="622" Canvas.Top="5" Source="/img/out_02.png"  MouseLeftButtonDown="Exit_window" />

        <TextBlock  Canvas.Left="100" Canvas.Top="80" x:Name="tb1" Text="설비 점검을 시작하시겠습니까??" FontFamily="/font/#KoPubDotum Bold" FontSize="40" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"  />

        <TextBlock Canvas.Left="100" Canvas.Top="60" x:Name="tb2" Text="!! 설비 점검 중 !!" FontFamily="/font/#KoPubDotum Bold" FontSize="75" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <Border Canvas.Left="125" Canvas.Top="165" BorderBrush="#4D99D2"  BorderThickness="2" Width="110" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <TextBlock Text="구분" Background="#DAE3F3" FontFamily="/font/#KoPubDotum Medium"  Focusable="True"  FontSize="25" TextAlignment="Center" Padding="0,10,0,0"/>
        </Border>

