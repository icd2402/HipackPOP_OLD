        <Button Canvas.Left="250" Canvas.Top="300" Height="70" Width="200" BorderBrush="#4D99D2" Background="#8FAADC" Content="시   작" FontFamily="/font/#KoPubDotum Bold" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Button_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>

        <ComboBox x:Name="구분combo" Canvas.Left="250" Canvas.Top="165" FontSize="25" Background="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="320" Height="50" SelectionChanged="구분ComboBox_SelectionChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontSize" Value="25" />
                </Style>
            </ComboBox.ItemContainerStyle>

            <ComboBoxItem Content="고장"/>
            <ComboBoxItem Content="점검"/>
            <ComboBoxItem Content="부품교체"/>

        </ComboBox>

        <ComboBox x:Name="점검명combo" Canvas.Left="250" Canvas.Top="225" FontSize="25" Background="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="320" Height="50" SelectionChanged="점검명ComboBox_SelectionChanged">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontSize" Value="25" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>
        
        
        
        
        
