        </Border>-->

        <Border Canvas.Left="125" Canvas.Top="225"  BorderBrush="#4D99D2"  BorderThickness="2" Width="110" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <TextBlock Text="점검명" Background="#DAE3F3" FontFamily="/font/#KoPubDotum Medium"  Focusable="True"  FontSize="25" TextAlignment="Center" Padding="0,10,0,0"/>
        </Border>

        <!--<Border Canvas.Left="250" Canvas.Top="225" BorderBrush="#4D99D2" BorderThickness="2" Width="320" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" >
