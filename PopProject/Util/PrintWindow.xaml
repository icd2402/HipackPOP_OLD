<Window x:Class="Monitor.Util.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitor.Util"
        mc:Ignorable="d"
        Title="PrintWindow" Height="924" Width="1340" MaxHeight="924" MaxWidth="1340" WindowStyle="None" AllowsTransparency="True" PreviewKeyDown="Window_PreviewKeyDown" Background="{x:Null}" >

    <Window.Resources >
        <ResourceDictionary >

            <Style TargetType="Button" x:Key="ButtonStyle">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Height" Value="90"/>
                <Setter Property="Margin" Value="0,15"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Label" x:Key="ButtonLabel">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="ExtraBold" />
                <!--<Setter Property="FontFamily" Value="{StaticResource FontName}"/>-->
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="Gray" BorderThickness="0" Background="White" Margin="5">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="Gray" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions >
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="Title_Panel" Grid.ColumnSpan="2" LastChildFill="True" Background="#3399FF" MouseDown="Title_Panel_MouseDown"   >
                <Image DockPanel.Dock="Left" Source="/Image/favi_출력화면.png" />
                <Button x:Name="닫기" DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}" Height="34" Width="38" Margin="5,0" Click="Button_Click"  >
                    <Image Source="/Image/icon_x.png" Width="17" Height="17" />
                </Button>
                <Button x:Name="최소화" DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}" Height="34" Width="38" Margin="5,0" Click="Button_Click" >
                    <Image Source="/Image/icon_-.png" Width="17" Height="17" />
                </Button>
                <Label DockPanel.Dock="Left" Content="출력화면" Style="{StaticResource ButtonLabel}" HorizontalAlignment="Left" FontSize="17" Margin="5,0"   />
            </DockPanel>


            <DockPanel Grid.Row="2" Background="#4B4B4B" LastChildFill="False"  >
                <Button x:Name="출력" DockPanel.Dock="Top" Style="{StaticResource ButtonStyle}" Margin="0,40,0,20" Click="Button_Click">
                    <DockPanel  >
                        <Label Content="인쇄하기" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_출력.png" Width="45" Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
                <Button x:Name="방향" DockPanel.Dock="Top"  Style="{StaticResource ButtonStyle}" Click="Button_Click">
                    <DockPanel  >
                        <Label Content="가로/세로" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_가로세로.png" Width="45"  Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
                <Button x:Name="확대" DockPanel.Dock="Top"  Style="{StaticResource ButtonStyle}" Click="Button_Click">
                    <DockPanel  >
                        <Label Content="확대/축소" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_원본보기.png" Width="45"  Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
                <Button x:Name="이미지" DockPanel.Dock="Top"  Style="{StaticResource ButtonStyle}" Click="Button_Click">
                    <DockPanel  >
                        <Label Content="이미지저장" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_이미지저장.png" Width="45" Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
                <Button x:Name="엑셀" DockPanel.Dock="Top"  Style="{StaticResource ButtonStyle}" Click="Button_Click">
                    <DockPanel  >
                        <Label Content="엑셀저장" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_엑셀저장.png" Width="45"  Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
                <Button x:Name="종료" DockPanel.Dock="Bottom" Style="{StaticResource ButtonStyle}" Margin="0,30" Click="Button_Click"  >
                    <DockPanel  >
                        <Label Content="닫   기" DockPanel.Dock="Bottom" Style="{StaticResource ButtonLabel}"/>
                        <Image Source="/Image/button_닫기.png" Width="45"  Margin="0,0,0,10"/>
                    </DockPanel>
                </Button>
            </DockPanel>
            <!--본문-->
            <DocumentViewer Grid.Column="1" Grid.Row="1" x:Name="PrintViewer" x:FieldModifier="public" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" VerticalPageSpacing="100"  >
                <DocumentViewer.Style >
                    <Style TargetType="DocumentViewer">
                        <Setter Property="Background" Value="#f7f8fb"/>
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="ContextMenu" Value="{x:Null}"/>
                        <Setter Property="Template" >
                            <Setter.Value >
                                <ControlTemplate TargetType="DocumentViewer" >
                                    <Grid >
                                        <Grid.RowDefinitions  >
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer x:Name="PART_ContentHost" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DocumentViewer.Style>
            </DocumentViewer>
        </Grid>

    </Border>
</Window>
