            <Button x:Name="key_5" Width="80" Height="80" Content="5" FontSize="25" FontWeight="Bold" Canvas.Top="148" Canvas.Left="104" Click="Button_Click"/>
            <Button x:Name="key_6" Width="80" Height="80" Content="6" FontSize="25" FontWeight="Bold" Canvas.Top="148" Canvas.Left="196" Click="Button_Click"/>
