<Window x:Class="PopProject.KeyBoard.Win_KeyBoard4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.KeyBoard"
        mc:Ignorable="d"
        Title="Win_KeyBoard4" Height="177" Width="287.733" AllowsTransparency="True" WindowStyle="None"  Loaded="Keyboard_loaded">
    <Border BorderThickness="1" BorderBrush="Black">
        <Canvas>
            <Image Source="/img/back_03-1.png" Stretch="Fill" Canvas.Left="-1" Width="287" Height="71" MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
            <TextBox x:Name="txtbox" Text="" FontWeight="Bold" TextAlignment="Center" FontSize="35"  Width="131" Height="56" Canvas.Left="82" Canvas.Top="6" />

            <TextBlock Text="타공값" FontSize="24" FontWeight="Bold" Foreground="White" Canvas.Top="18" Canvas.Left="4"/>
            <Button x:Name="key_13" Width="80" Height="80" Content="지움" FontSize="25" FontWeight="Bold" Canvas.Top="83" Canvas.Left="11" Click="Button_Click"/>
            <Button x:Name="key_14" Background="Green" Foreground="White" Width="80" Height="80" Content="저장" FontSize="25" FontWeight="Bold" Canvas.Top="83" Canvas.Left="104" Click="Button_Click"/>
            <Button x:Name="key_15" Background="Red" Width="80" Height="80" Content="닫기" FontSize="25" FontWeight="Bold" Canvas.Top="83" Canvas.Left="196" Click="Button_Click"/>

        </Canvas>
    </Border>

</Window>
