<Window x:Class="PopProject.MessageBox.PrintMemoBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.MessageBox"
        mc:Ignorable="d"
        Title="PrintMemoBox" Height="380" Width="550" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Border BorderThickness="1" BorderBrush="Black">
        <Canvas>
            <Image Source="/img/back_03.png" Canvas.Left="-2"  Width="551" MouseLeftButtonDown="Image_MouseLeftButtonDown_4"></Image>
            <Image Source="/img/bn_08.png" Canvas.Left="193" Canvas.Top="264" Width="170" Height="96" MouseLeftButtonDown="Image_MouseLeftButtonDown_2"/>
            <Image Source="/img/out_01.png" Canvas.Left="453" Canvas.Top="276" MouseLeftButtonDown="Image_MouseLeftButtonDown_3"/>
            
            <Border  BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="120" Height="50"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="20" Canvas.Top="288" MouseLeftButtonDown="Keyboard_call" >
                <TextBlock Text="키보드" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF565656" Canvas.Left="20" Canvas.Top="340" FontFamily="/font/#KoPubDotum Medium"  />
            </Border>
            
            <TextBlock Text="|" Foreground="White" FontSize="24" Canvas.Left="18" Canvas.Top="11"></TextBlock>
            <TextBlock Text="비고란 입력" Foreground="White" FontSize="24" Canvas.Left="38" Canvas.Top="18" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
            <TextBox x:Name="unique_text" Canvas.Top="80" Canvas.Left="10" Width="530" Height="170" Text="" FontSize="15"/>
            
            <TextBlock  Canvas.Top="80" Canvas.Left="10"  Text="비고란을 입력하세요." FontSize="20" Margin="2,0,0,0">

                <TextBlock.Style>
                    
                    <Style TargetType="TextBlock">
                        
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Setter Property="Foreground" Value="Black"/>
                        
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=unique_text}" Value="">

                                <Setter Property="Visibility" Value="Visible"/>
                                
                            </DataTrigger>

                        </Style.Triggers>
                        
                    </Style>
                    
                </TextBlock.Style>
                
            </TextBlock>
            
        </Canvas>
    </Border>
</Window>
