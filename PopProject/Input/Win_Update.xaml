<Window x:Class="PopProject.Input.Win_Update"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Input"
        mc:Ignorable="d"
         Title="Win_Update" Height="440" Width="550" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    <Border BorderThickness="1" BorderBrush="Black">
        <Canvas>
            <Image Source="/img/back_03.png" Canvas.Left="-2"  Width="551" MouseLeftButtonDown="Image_MouseLeftButtonDown_4"></Image>
            <Image Source="/img/bn_08.png" Canvas.Left="193" Canvas.Top="284" Width="170" Height="96" MouseLeftButtonDown="Image_MouseLeftButtonDown_2"/>
            <Image Source="/img/out_01.png" Canvas.Left="453" Canvas.Top="296" MouseLeftButtonDown="Image_MouseLeftButtonDown_3"/>
            <Image Grid.Row="2" Height="50" Width="80" Source="/img/plus_01.png" Canvas.Left="353" Canvas.Top="174" MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
            <Image Grid.Row="2" Height="50" Width="80" Source="/img/plus_02.png" Canvas.Left="433" Canvas.Top="174"  MouseLeftButtonDown="Image_MouseLeftButtonDown_1"></Image>
            <TextBlock Text="|" Foreground="White" FontSize="24" Canvas.Left="18" Canvas.Top="11"></TextBlock>
            <TextBlock Text="불량정보 수정" Foreground="White" FontSize="24" Canvas.Left="38" Canvas.Top="18" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
            <TextBlock Text="불량사유" FontSize="22" FontFamily="/font/#KoPubDotum Bold" Canvas.Left="42" Canvas.Top="109"/>
            <TextBlock Text="불량수량" FontSize="22" FontFamily="/font/#KoPubDotum Bold" Canvas.Left="42" Canvas.Top="185"/>
            <Border BorderBrush="#abbfd9" BorderThickness="2" Width="366" Height="50" Canvas.Left="147" Canvas.Top="97"  >
                <ComboBox x:Name="combo" BorderBrush="{x:Null}" Background="White" FontFamily="/font/#KoPubDotum Medium" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="25" Margin="0,5,0,10"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>
            <Border BorderBrush="#abbfd9" BorderThickness="2" Width="190" Height="50" Canvas.Left="147" Canvas.Top="176" >
                <TextBox BorderBrush="{x:Null}" Text="{Binding perrCount, UpdateSourceTrigger=PropertyChanged}" Margin="1,0,-1,0" FontSize="22" TextAlignment="Center" VerticalContentAlignment="Center" MouseLeftButtonDown="TextBox_MouseLeftButtonDown" Focusable="False" />
            </Border>
        </Canvas>
    </Border>
</Window>
