<Window x:Class="PopProject.Input.Plc_Pop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Input"
        mc:Ignorable="d"
        Title="Plc_Pop" Height="500" Width="320" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
    <Border BorderThickness="1" BorderBrush="Black">
        
        <Canvas Margin="0,-5,0,5">
            
            <Image Source="/img/back_03-1.png" Stretch="Fill" Canvas.Left="-1" Width="320" Height="45" MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
            <TextBlock Text="X" Canvas.Top="5" Canvas.Left="290" Width="29" Height="35" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Background="#0000" MouseLeftButtonDown="exit" />
            <TextBlock x:Name="ip" Text="192.168.7.7" TextAlignment="Left" Canvas.Top="10" Canvas.Left="10" Width="190" Height="30" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Background="#0000" MouseLeftButtonDown="ip_input"/>

            <TextBlock x:Name="거래처" Text="1" Canvas.Top="56" Canvas.Left="10" Width="280" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock x:Name="품명"  Text="2" Canvas.Top="90" Canvas.Left="10" Width="280" Height="25" FontSize="20" TextAlignment="Left" Foreground="Blue" Background="#0000" FontFamily="/font/#KoPubDotum Medium"/>

            <TextBlock Text="작업모델" Canvas.Top="136" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <ComboBox SelectedIndex="0" Canvas.Left="160" FontSize="16" VerticalContentAlignment="Center" Canvas.Top="132" Width="140" Height="30"  x:Name="combo" BorderBrush="{x:Null}" Background="White" FontFamily="/font/#KoPubDotum Medium"  Focusable="True">
                <ListBoxItem >1합 박스</ListBoxItem>
                <ListBoxItem>2합 박스</ListBoxItem>
                <ListBoxItem>인쇄물</ListBoxItem>
                <ListBoxItem>H형</ListBoxItem>
                <ListBoxItem>H-COVER형</ListBoxItem>
            </ComboBox>
            <TextBlock Text="생산매수" Canvas.Top="182" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="작업지시" Canvas.Top="180" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Focusable="false" Margin="1,0,0,1" MouseLeftButtonDown="Input_value"></TextBox>
            <TextBlock Text="장" Canvas.Top="222" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="장" Canvas.Top="220" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Margin="1,0,0,1" MouseLeftButtonDown="Input_value" Focusable="false"></TextBox>
            <TextBlock Text="폭" Canvas.Top="262" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="폭" Canvas.Top="260" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Margin="1,0,0,1" MouseLeftButtonDown="Input_value" Focusable="false"></TextBox>
            <TextBlock Text="고" Canvas.Top="302" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="고" Canvas.Top="300" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Margin="1,0,0,1" MouseLeftButtonDown="Input_value" Focusable="false"></TextBox>
            <TextBlock Text="갭" Canvas.Top="342" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="갭" Canvas.Top="340" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Margin="1,0,0,1" MouseLeftButtonDown="Input_value" Focusable="false"></TextBox>
            <TextBlock Text="미미" Canvas.Top="382" Canvas.Left="10" Width="80" Height="25" FontSize="20" TextAlignment="Left" Foreground="Black" Background="#0000" FontFamily="/font/#KoPubDotum Light"/>
            <TextBox x:Name="미미" Canvas.Top="380" Canvas.Left="160" FontSize="18" Width="140"  Height="28"  BorderBrush="Gray" VerticalContentAlignment="Center" Margin="1,0,0,1" MouseLeftButtonDown="Input_value" Focusable="false"></TextBox>
            <Border  BorderThickness="2" Background="White" CornerRadius="5" BorderBrush="#FF747474" Width="80" Height="40"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="120" Canvas.Top="435" MouseLeftButtonDown="Done" >
                <TextBlock Text="적 용" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF565656" Canvas.Left="20" Canvas.Top="118" FontFamily="/font/#KoPubDotum Medium"  />
            </Border>
        </Canvas>
    </Border>

</Window>
