        <TextBlock Text=" |" Foreground="White" FontSize="20" Canvas.Left="1019" Canvas.Bottom="19" Canvas.Top="768"/>
        <TextBlock x:Name="txtTotalPerrCount" Text="{Binding }" Foreground="Red" FontSize="20" Canvas.Left="1055" Canvas.Bottom="19" Canvas.Top="773" FontFamily="/font/#KoPubDotum Bold"/>
        <Canvas x:Name="can" Background="Black" Height="820" Width="1105" Opacity="0.35" Visibility="Collapsed">
        </Canvas>
        <TextBlock x:Name="cantb" Text="저장중 입니다...." FontWeight="Bold" FontSize="25" Canvas.Left="202" Canvas.Top="465" Visibility="Collapsed" Foreground="Black" Opacity="1"></TextBlock>
