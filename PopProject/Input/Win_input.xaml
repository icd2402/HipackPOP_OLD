        <Image Source="/img/back_06.png"  Width="555" Height="70" Stretch="Fill" Canvas.Left="550"/>
        <Border BorderThickness="0,1,1,1" Width="555" Height="820" BorderBrush="Black" Canvas.Left="550"/>
        <TextBlock Text="{Binding orderCount, StringFormat=수주량  |  {0}}" Foreground="White" FontSize="20" Canvas.Left="569" Canvas.Top="25" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
