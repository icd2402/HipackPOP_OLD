                      PreviewMouseMove="ScrollViewer_PreviewMouseMove">
            <ItemsControl x:Name="ic" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" Width="552" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Canvas Width="100" Height="50" >
                                    <TextBlock Canvas.Left="23"  Canvas.Top="13" Text="{Binding pworkDate, StringFormat=MM/dd}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"/>
                                </Canvas>
                                <Border Width="1" BorderBrush="Black" BorderThickness="1"></Border>
                                <ItemsControl ItemsSource="{Binding errorModelOb}" >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2c3e50"  BorderThickness="0,0,0,0.5" PreviewMouseDown="Border_MouseDown" Background="White">
                                                <Canvas  Height="50" x:Name="can_memo">
                                                    <TextBlock Canvas.Left="7" Canvas.Top="13" Text="{Binding updateTime,StringFormat=HH:mm}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                                    <!--<TextBlock Canvas.Left="70" Width="60"  TextAlignment="Left" Canvas.Top="13" Text="시작" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>-->
                                                    <TextBlock x:Name="memo" Canvas.Left="90" Canvas.Top="13" Text="{Binding memo}" FontSize="20" FontFamily="/font/#KoPubDotum Medium" Foreground="{Binding fontColor}"></TextBlock>
                                                    <TextBlock x:Name="result" Canvas.Left="355" Canvas.Top="13" Width="80"  TextAlignment="Right" Visibility="{Binding fontVisible}" Text="{Binding perrCount}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                                </Canvas>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
