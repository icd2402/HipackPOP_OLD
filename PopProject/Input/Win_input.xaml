        <Image Height="50" Width="80" Source="/img/plus_01.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="382" Canvas.Top="427" MouseLeftButtonDown="Result_count_minus"></Image>
        <Image  Height="50" Width="80" Source="/img/plus_02.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="461" Canvas.Top="427" MouseLeftButtonDown="Result_count_plus"></Image>

