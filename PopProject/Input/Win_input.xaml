            </TextBlock>
            <!--<ComboBox x:Name="combo" BorderBrush="{x:Null}" Background="White" FontFamily="/font/#KoPubDotum Medium"  Focusable="True" Text="{Binding errorModel.memo}" MaxDropDownHeight="1000">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="25" Margin="0,5,0,10"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>-->

        </Border>
