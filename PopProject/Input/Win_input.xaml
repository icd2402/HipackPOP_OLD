                    <ItemsControl x:Name="combo" Focusable="false" AlternationCount="1000">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Focusable="False"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:Name="dt">
                                <Canvas PreviewMouseLeftButtonDown ="PreCanvas_MouseDown" Height="38">
                                    <TextBlock Text="{Binding}"  Width="250" FontSize="18" Margin="10,5,0,10"/>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Canvas>


        </Border>
        <Border x:Name="error_multi" Visibility="Collapsed" BorderBrush="#abbfd9" Background="white" BorderThickness="2" Width="240" Height="450" Grid.Row="2" Canvas.Left="293" Canvas.Top="282">
