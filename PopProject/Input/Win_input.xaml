        <TextBlock x:Name="Pre_Count" Grid.Row="1"  FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="179" TextAlignment="Right" Width="183" Canvas.Top="261" Foreground="Blue" FontFamily="/font/#KoPubDotum Bold"/>


