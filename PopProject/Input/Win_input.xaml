        <Image Grid.Row="2" Height="50" Width="80" Source="/img/plus_02.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="441" Canvas.Top="667" MouseLeftButtonDown="Result_badCount_plus"></Image>

