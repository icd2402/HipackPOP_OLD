        </Border>
        <TextBlock Grid.Row="1" Text="계     획" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="60" Canvas.Top="227" FontFamily="/font/#KoPubDotum Medium"/>
