                <TextBlock MouseLeftButtonDown="Error_multibuttondownexit" Background="Blue" Foreground="White" Text="닫기" Width="235" FontSize="20" TextAlignment="Center" Height="30" Padding="0,1,0,0"/>

                <ScrollViewer Canvas.Top="31" Width="235" VerticalScrollBarVisibility="Auto" Height="415" x:Name="sv2" >
                    <ItemsControl x:Name="combo1" Focusable="false" AlternationCount="1000">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Focusable="False"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
