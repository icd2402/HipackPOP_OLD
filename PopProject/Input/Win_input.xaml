            <TextBlock Text="aa"></TextBlock>
        </Image>-->

        <Border BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="94" Height="68" Grid.Row="1"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="418" Canvas.Top="540" MouseLeftButtonDown="Win_input_exit">
            <TextBlock Text="닫기" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontFamily="/font/#KoPubDotum Bold" Foreground="#FF565656"/>
        </Border>

        <Border x:Name="box" BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="130" Height="68" Grid.Row="1"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="37" Canvas.Top="490" MouseLeftButtonDown="Detail_item">
