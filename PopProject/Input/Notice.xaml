<Window x:Class="PopProject.Input.Notice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Input"
        mc:Ignorable="d"
        Title="공지사항" Height="510" Width="830" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:DateFormatConverter x:Key="dateFormatConverter" />
        <local:IndexConverter x:Key="IndexConverter"/>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/img/back_02.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Grid.Row="0" Background="White" Opacity="0.5"/>

        <Canvas x:Name="cName" Grid.Row="0" Margin="0">
            <TextBlock Text="일 자" FontSize="18" Canvas.Top="10" Canvas.Left="37" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Text="업데이트 내용" FontSize="18" Canvas.Top="10" Canvas.Left="410" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
        </Canvas>

        <Border x:Name="NoticeDateBorder" Grid.Row="1" Margin="5,5,705,5" BorderBrush="Black" CornerRadius="5" BorderThickness="1,1,1,1" Background="WhiteSmoke" Focusable="False">
            <ScrollViewer x:Name="sv" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="ic" Focusable="False" AlternationCount="10000">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Focusable="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:Name="dt">
                            <Canvas Height="60" Focusable="False" PreviewMouseLeftButtonDown="Canvas_PreviewMouseDown" Tag="{Binding Notice}">
                                <!-- 날짜 -->
                                <TextBlock Text="{Binding Update_Date, Converter={StaticResource dateFormatConverter}}" Width="600" FontSize="17" Foreground="Black" Canvas.Top="16" Canvas.Left="10" />
                                <Border BorderBrush="#2c3e50" BorderThickness="0,0,0,1" Width="110" Canvas.Bottom="0"></Border>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>



        <Border x:Name="NoticeBorder" Grid.Row="1" Margin="114,5,5,5" CornerRadius="5" BorderBrush="Black" BorderThickness="1,1,1,1" Background="WhiteSmoke" Focusable="False">
            <TextBlock x:Name="NoticeData" Text="" Margin="10" FontSize="17" Foreground="Black"/>
        </Border>

        <TextBlock x:Name="tb1" Text="업데이트 내용이 없습니다." Visibility="Collapsed" Foreground="Black" FontSize="25" Grid.Row="1"  TextAlignment="Center" VerticalAlignment="Center" Margin="306,188,182,211" Height="40"/>

    </Grid>
</Window>
