<Window x:Class="PopProject.Input.Ip_input"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Input"
        mc:Ignorable="d"
        Title="Ip_input" Height="100" Width="250" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Canvas>
        <Label Content="IP" Height="28" HorizontalAlignment="Left" x:Name="Ip" VerticalAlignment="Top" Canvas.Left="16" Canvas.Top="16" FontWeight="Bold" />
        <TextBox x:Name="ip" Width="104" Canvas.Left="68" Canvas.Top="16" Height="24" />

        <Label Content="Port" Height="28" HorizontalAlignment="Left" x:Name="Port" VerticalAlignment="Top" Canvas.Left="16" Canvas.Top="46" FontWeight="Bold" />
        <TextBox x:Name="port" Width="104" Canvas.Left="68" Canvas.Top="46" Height="24" />
        <Border  BorderThickness="2" Background="White" CornerRadius="5" BorderBrush="#FF747474" Width="50" Height="30"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="180" Canvas.Top="28" MouseLeftButtonDown="Done" >
            <TextBlock Text="적 용" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF565656" Canvas.Left="20" Canvas.Top="118" FontFamily="/font/#KoPubDotum Medium"  />
        </Border>
    </Canvas>
</Window>
