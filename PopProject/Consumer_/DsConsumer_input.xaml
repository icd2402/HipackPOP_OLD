<Window x:Class="PopProject.Consumer_.DsConsumer_input"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.Consumer_"
        mc:Ignorable="d"
        Title="DsConsumer_input" Height="820" Width="550" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">

    <Canvas >
        <Border VerticalAlignment="Stretch" BorderBrush="Black" BorderThickness="1" Width="550" Height="820"></Border>
        <Image Source="/img/back_05.png" Width="550" MouseLeftButtonDown="Canvas_MouseDown" ></Image>
        <Image x:Name="changeButtonOut" Width="66" Height="66" Source="/img/open_01.png" HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.Left="484" Canvas.Top="20" MouseLeftButtonDown="ChangeButton_MouseDown"/>
        <Image x:Name="changeButtonIn"  Visibility="Collapsed" Width="66" Height="66" Source="/img/close_01.png" HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.Left="484" Canvas.Top="20" MouseDown="ChangeButton_MouseDown"/>

        <!--<Image Visibility="{Binding newProd}" Width="48" Height="28" Source="/img/new.png" HorizontalAlignment="Left" VerticalAlignment="Bottom" Canvas.Left="47" Canvas.Top="119" ></Image>-->
        <TextBlock Text="{Binding customSName}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Canvas.Left="46" Canvas.Top="18" FontFamily="/font/#KoPubDotum Medium" />
        <TextBlock Text="{Binding prodName}" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Canvas.Left="46" Canvas.Top="54" FontFamily="/font/#KoPubDotum Bold"/>
        <TextBlock Text="{Binding pSize}" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Canvas.Left="380" Canvas.Top="118" FontFamily="/font/#KoPubDotum Medium"  />
        <TextBox x:Name="tbBarcode" Text="" HorizontalAlignment="Left" Width="200" Height="50" Visibility="Hidden" Opacity="0" KeyDown="TbBarcode_KeyDown"></TextBox>

        <TextBlock Text="작 업 팀 :" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="66" Canvas.Top="178" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
        <TextBlock Text="{Binding workerName}" Foreground="Green" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="148" Canvas.Top="178" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
        <TextBlock Text="원단체크:" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="307" Canvas.Top="178" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
        <TextBlock x:Name="tbCheck"  Foreground="Green" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="395" Canvas.Top="178" FontFamily="/font/#KoPubDotum Medium"></TextBlock>


        <TextBlock Grid.Row="1" Text="계     획" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="60" Canvas.Top="237" FontFamily="/font/#KoPubDotum Medium"/>
        <TextBlock Grid.Row="1" Foreground="Blue" Text="재 공 품" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="60" Canvas.Top="265" FontFamily="/font/#KoPubDotum Medium"/>

        <TextBlock Grid.Row="1" Text="카 운 트"  FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="61" Canvas.Top="304" FontFamily="/font/#KoPubDotum Medium"/>
        <TextBlock Grid.Row="1" Text="불량수량"  FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="61" Canvas.Top="370" FontFamily="/font/#KoPubDotum Medium"/>
        <TextBlock Grid.Row="1" Text="생산수량"  FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="61" Canvas.Top="439" FontFamily="/font/#KoPubDotum Medium"/>

        <TextBlock Text="|" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="170" Canvas.Top="229"/>
        <TextBlock Text="|" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="170" Canvas.Top="257"/>

        <TextBlock Text="|" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="170" Canvas.Top="295"/>
        <TextBlock Text="|" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="170" Canvas.Top="361"/>
        <TextBlock Text="|" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="170" Canvas.Top="431"/>

        <Border BorderThickness="0,0,0,1" BorderBrush="Black" Width="170" Height="1" Canvas.Left="239" Canvas.Top="340"></Border>
        <Border BorderThickness="0,0,0,1" BorderBrush="Black" Width="170" Height="1" Canvas.Left="239" Canvas.Top="406"/>

        <TextBlock Grid.Row="1" Text="{Binding sumPlanCount}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="179" TextAlignment="Right" Width="183" Canvas.Top="236" Foreground="#26414A" FontFamily="/font/#KoPubDotum Bold"/>
        <TextBlock Text="{Binding pCnt, StringFormat= (0통)}" Visibility="{Binding pCntVisible}" Canvas.Left="426" Canvas.Top="236" FontSize="28" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <TextBlock x:Name="Pre_Count" Grid.Row="1"  FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="179" TextAlignment="Right" Width="183" Canvas.Top="261" Foreground="Blue" FontFamily="/font/#KoPubDotum Bold"/>

        <!--<TextBlock Text="{Binding pCnt, StringFormat= X {0}}" Visibility="{Binding pCntVisible}" Canvas.Left="428" Canvas.Top="302" FontSize="28" FontFamily="/font/#KoPubDotum Bold"></TextBlock>-->
        <TextBox x:Name="consumer_count" Grid.Row="1" Text="{Binding count, UpdateSourceTrigger=PropertyChanged}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="262" TextAlignment="Right" Width="100"  Canvas.Top="302" FontFamily="/font/#KoPubDotum Bold" BorderBrush="{x:Null}"/>


        <TextBlock Grid.Row="1" Text="{Binding perrCount ,UpdateSourceTrigger=PropertyChanged}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="262" TextAlignment="Right" Width="100"  Canvas.Top="368" Foreground="Red" FontFamily="/font/#KoPubDotum Bold"/>


        <TextBox x:Name="tbResult" Grid.Row="1" Focusable="False" BorderBrush="{x:Null}"  MouseLeftButtonDown="TbResult_MouseLeftButtonDown" Text="{Binding count, UpdateSourceTrigger=PropertyChanged}" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="262" TextAlignment="Right" Width="100" Canvas.Top="434" Foreground="#26414A" FontFamily="/font/#KoPubDotum Bold"/>
        <Image Height="50" Width="80" Source="/img/plus_01.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="382" Canvas.Top="427" MouseLeftButtonDown="Result_count_minus"></Image>
        <Image  Height="50" Width="80" Source="/img/plus_02.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="461" Canvas.Top="427" MouseLeftButtonDown="Result_count_plus"></Image>

        <Image Source="{Binding imagePath}" Width="170" Height="96" Grid.Row="1" VerticalAlignment="Bottom" Canvas.Left="203" Canvas.Top="526" MouseLeftButtonDown="Image_MouseLeftButtonDown" />
        <!--<Image Source="/img/out_01.png" Width="94" Height="68" Grid.Row="1" Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="418" Canvas.Top="516" MouseDown="Image_MouseDown">
            <TextBlock Text="aa"></TextBlock>
        </Image>-->

        <Border BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="94" Height="68" Grid.Row="1"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="418" Canvas.Top="540" MouseLeftButtonDown="Win_input_exit">
            <TextBlock Text="닫기" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontFamily="/font/#KoPubDotum Bold" Foreground="#FF565656"/>
        </Border>

        <Border x:Name="box"  BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="130" Height="68" Grid.Row="1"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="37" Canvas.Top="490" MouseLeftButtonDown="Detail_item">
            <TextBlock Text="세부내역" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontFamily="/font/#KoPubDotum Bold" Foreground="#FF565656"/>
        </Border>

        <Border x:Name="box1"  BorderThickness="2" Background="White" CornerRadius="10" BorderBrush="#FF747474" Width="130" Height="68" Grid.Row="1"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Canvas.Left="37" Canvas.Top="570" MouseLeftButtonDown="이월">
            <TextBlock Text="이    월" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontFamily="/font/#KoPubDotum Bold" Foreground="#FF565656"/>
        </Border>


        <Canvas Grid.Row="2" Background="#dfe4e4" Width="548" Height="170" Canvas.Top="649" Canvas.Left="1"/>

        <TextBlock Text="불량수량" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="2" Canvas.Left="48" Canvas.Top="681" FontFamily="/font/#KoPubDotum Bold"/>
        <Border BorderBrush="#abbfd9" BorderThickness="2" Width="190" Height="50" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="669" Canvas.Left="153">
            <TextBox x:Name="tbError" BorderBrush="{x:Null}"  Focusable="False" MouseLeftButtonDown="TbResult_MouseLeftButtonDown" FontSize="22" TextAlignment="Center" VerticalContentAlignment="Center" Text="{Binding errorModel.perrCount}"></TextBox>
        </Border>

        <TextBlock Text="불량사유" FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="2" Canvas.Left="48" Canvas.Top="748" FontFamily="/font/#KoPubDotum Bold"/>
        <Border BorderBrush="#abbfd9" BorderThickness="2" Width="280" Height="50" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="153" Canvas.Top="732" >
            <ComboBox x:Name="combo" BorderBrush="{x:Null}" Background="White" FontFamily="/font/#KoPubDotum Medium"  Focusable="True" Text="{Binding errorModel.memo}" MaxDropDownHeight="1000">
                <ComboBox.ItemTemplate>

                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="25" Margin="0,5,0,10"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Border>


        <Image Grid.Row="2" Height="50" Width="80" Source="/img/plus_01.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="361" Canvas.Top="667" MouseLeftButtonDown="Result_badCount_minus"></Image>
        <Image Grid.Row="2" Height="50" Width="80" Source="/img/plus_02.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="441" Canvas.Top="667" MouseLeftButtonDown="Result_badCount_plus"></Image>
        <Image x:Name="errorBtn" Grid.Row="2" Height="50" Width="65" Source="/img/bn_07.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.Left="454" Canvas.Top="732" MouseLeftButtonDown="Image_MouseLeftButtonDown_1"></Image>



        <Image Source="/img/back_06.png"  Width="555" Height="70" Stretch="Fill" Canvas.Left="550"/>
        <Border BorderThickness="0,1,1,1" Width="555" Height="820" BorderBrush="Black" Canvas.Left="550"/>
        <TextBlock Text="{Binding orderCount, StringFormat=수주량  |  {0}}" Foreground="White" FontSize="20" Canvas.Left="569" Canvas.Top="25" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <TextBlock Text="{Binding orderLast, StringFormat=납기   |   {0:yyyy/MM/dd}}" Foreground="White" FontSize="20" Canvas.Left="908" Canvas.Top="25" FontFamily="/font/#KoPubDotum Bold" Height="20"></TextBlock>



        <Image  Width="555" Height="70" Source="/img/back_07.png" Canvas.Bottom="0" Stretch="Fill" Canvas.Left="549" Canvas.Top="750"></Image>


        <ScrollViewer x:Name="sv" Width="555" Height="680" Canvas.Left="550" Canvas.Top="70" VerticalScrollBarVisibility="Hidden" 
                      PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ScrollViewer_PreviewMouseLeftButtonUp" 
                      PreviewMouseMove="ScrollViewer_PreviewMouseMove">
            <ItemsControl x:Name="ic" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" Width="552" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Canvas Width="100" Height="50" >
                                    <TextBlock Canvas.Left="23"  Canvas.Top="13" Text="{Binding pworkDate, StringFormat=MM/dd}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"/>
                                </Canvas>
                                <Border Width="1" BorderBrush="Black" BorderThickness="1"></Border>
                                <ItemsControl ItemsSource="{Binding errorModelOb}" >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2c3e50"  BorderThickness="0,0,0,0.5" PreviewMouseDown="Border_MouseDown" Background="White">
                                                <Canvas  Height="50" >
                                                    <TextBlock Canvas.Left="7" Canvas.Top="13" Text="{Binding updateTime,StringFormat=HH:mm}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                                    <!--<TextBlock Canvas.Left="70" Width="60"  TextAlignment="Left" Canvas.Top="13" Text="시작" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>-->
                                                    <TextBlock Canvas.Left="90" Canvas.Top="13" Text="{Binding memo}" FontSize="20" FontFamily="/font/#KoPubDotum Medium" Foreground="{Binding fontColor}"></TextBlock>
                                                    <TextBlock Canvas.Left="355" Canvas.Top="13" Width="80"  TextAlignment="Right" Visibility="{Binding fontVisible}" Text="{Binding perrCount}" FontSize="20" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                                </Canvas>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="tbEmpty" Text="작업결과가 없습니다." FontSize="20" Canvas.Left="736" Canvas.Top="354"></TextBlock>

        <!--<TextBlock Text=" 계획" Foreground="White" FontSize="20" Canvas.Left="589" Canvas.Bottom="21" Canvas.Top="776" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <TextBlock Text=" |" Foreground="White" FontSize="20" Canvas.Left="635" Canvas.Bottom="19" Canvas.Top="770"></TextBlock>-->
        <TextBlock Text="{Binding pplanCount, StringFormat=계획  |  {0}}" Foreground="White" FontSize="20" Canvas.Left="579" Canvas.Bottom="19" Canvas.Top="775" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <!--<TextBlock Text=" 결과" Foreground="White" FontSize="20" Canvas.Left="760" Canvas.Bottom="21" Canvas.Top="775" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <TextBlock Text=" |" Foreground="White" FontSize="20" Canvas.Left="807" Canvas.Bottom="19" Canvas.Top="769"></TextBlock>-->
        <TextBlock Text="{Binding sumPworkCount, StringFormat=결과  |  {0}}" Foreground="White" FontSize="20" Canvas.Left="780" Canvas.Bottom="19" Canvas.Top="774" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
        <TextBlock Text=" 총불량" Foreground="White" FontSize="20" Canvas.Left="952" Canvas.Bottom="21" Canvas.Top="775" FontFamily="/font/#KoPubDotum Bold"/>
        <TextBlock Text=" |" Foreground="White" FontSize="20" Canvas.Left="1019" Canvas.Bottom="19" Canvas.Top="768"/>
        <TextBlock x:Name="txtTotalPerrCount" Text="{Binding }" Foreground="Red" FontSize="20" Canvas.Left="1055" Canvas.Bottom="19" Canvas.Top="773" FontFamily="/font/#KoPubDotum Bold"/>
        <Canvas x:Name="can" Background="Black" Height="820" Width="1105" Opacity="0.35" Visibility="Collapsed">

        </Canvas>
        <TextBlock x:Name="cantb" Text="저장중 입니다...." FontWeight="Bold" FontSize="25" Canvas.Left="202" Canvas.Top="465" Visibility="Collapsed" Foreground="Black" Opacity="1"></TextBlock>

    </Canvas>
</Window>