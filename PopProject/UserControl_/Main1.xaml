<UserControl x:Class="PopProject.UserControl_.Main1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PopProject.UserControl_"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1280">
            
    <UserControl.Resources>
        <local:IndexConverte x:Key="IndexConverte"/>
        <local:StrConverte x:Key="StrConverte"/>
    </UserControl.Resources>
        
    <Grid>
        
        <Grid.Background>
            <ImageBrush ImageSource="/img/back_02.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="110"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100*"/>

        </Grid.RowDefinitions>
        <TextBlock x:Name="tbMercName" Text="공 정" Foreground="White" Width="280" FontSize="40" TextAlignment="Center" Height="50" HorizontalAlignment="Center" FontFamily="/font/#KoPubDotum Bold" MouseLeftButtonDown="Mer_click"></TextBlock>
        <Button x:Name="btrSerial" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#FFE00000" BorderBrush="{x:Null}" Click="Serial_click" Margin="0,0,0,90"/>

        <TextBlock x:Name="corp_name" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,36,0,0" ></TextBlock>

        
        <!--Lock/Unlock-->
        <TextBlock x:Name="merc_lock" Text="LOCK" Foreground="White" Padding="5,0,0,0" TextAlignment="Justify" FontSize="15"  Margin="24,0,0,0" Width="100" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" MouseLeftButtonDown="Logout_click"></TextBlock>
        <Image x:Name="unlock_img" Source="/img/unlock.png" Height="23" Width="23" Visibility="Collapsed" Margin="1,83,1252,0" MouseLeftButtonDown="Logout_click"/>
        <Image x:Name="lock_img" Source="/img/lock.png" Height="23" Width="23" Visibility="Collapsed" Margin="6,83,1252,0" MouseLeftButtonDown="Logout_click"/>
        
        <!--설정, 원격연결, 종료-->
        <Image HorizontalAlignment="Right" VerticalAlignment="Center" Height="88" Width="88" Source="/img/notice.png" Margin="0,12,345,10" MouseLeftButtonDown="notice_MouseLeftButtonDown"/>
        <Image HorizontalAlignment="Right" VerticalAlignment="Center" Height="88" Width="88" Source="/img/change2.png" Margin="0,12,260,10" MouseLeftButtonDown="Change_workList"/>
        <Image HorizontalAlignment="Right" VerticalAlignment="Center" Height="88" Width="88" Source="/img/setting.png" Margin="0,12,175,10" MouseLeftButtonDown="Setting"/>
        <Image HorizontalAlignment="Right" VerticalAlignment="Center" Height="88" Width="88" Source="/img/b_01.png" Margin="0,11,90,10" MouseLeftButtonDown="Remote_click"/>
        <Image HorizontalAlignment="Right" VerticalAlignment="Center" Height="88" Width="88" Source="/img/b_exit.png" Margin="0,11,5,10" MouseLeftButtonDown="Program_exit"/>

        <!--날짜-->
        <TextBlock x:Name="txtDate"  FontSize="23" VerticalAlignment="Top" Text="2020년 10월 28일 화요일"  Margin="220,27,792,0"  FontFamily="/font/#KoPubBatang Medium" MouseLeftButtonDown="TxtDate_MouseLeftButtonDown"/>
        <TextBlock x:Name="txtClock"   FontSize="23" VerticalAlignment="Top" Text="오전 11:11" Margin="220,60,792,0"  FontFamily="/font/#KoPubBatang Medium" MouseLeftButtonDown="TxtTime_MouseLeftButtonDown"/>
        <TextBlock x:Name="txtDate2" Text="  《 " FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Center" Margin="178,24,1047,56" Width="55" MouseLeftButtonDown="Date_Click1"/>
        <TextBlock x:Name="txtDate3" Text="   》 " FontSize="22" FontWeight="Bold" VerticalAlignment="Center"  Visibility="Collapsed" HorizontalAlignment="Center" Margin="467,24,764,56" Width="49" MouseLeftButtonDown="Date_Click2"/>


        <Canvas Grid.Row="1" Background="White" Opacity="0.5">
            
        </Canvas>

        <Canvas x:Name="can1" Grid.Row="1" Margin="10,0,10,0">
            <Image Width="40" Height="40" Canvas.Left="8" Source="/img/title_01.png" MouseLeftButtonDown="Refresh"/>

            <TextBlock x:Name="tbNo" Text="NO" TextAlignment="Center" Width="30" Canvas.Top="11" MouseLeftButtonDown="Refresh" FontSize="18" Canvas.Left="14" FontWeight="Bold" Foreground="White" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock x:Name="div"  Canvas.Left="133" Canvas.Top="10" FontSize="18" Text="[수주일자] 거래처/품명" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold" MouseLeftButtonDown="Search_"/>
            <!--<TextBlock Canvas.Left="390" Canvas.Top="10" FontSize="18" Text="골" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>!-->
            <TextBlock x:Name="info" Canvas.Left="395" Canvas.Top="10" FontSize="18" Text="원단정보" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="586" Canvas.Top="10" FontSize="18" Text="공정" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock x:Name="tbPrintNo" Canvas.Left="835" Canvas.Top="10" FontSize="18" Text="작업정보" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="1018" Canvas.Top="10" FontSize="18" Text="계획" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="1076" Canvas.Top="10" FontSize="18" Text="결과" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="1168" Canvas.Top="10" FontSize="18" Text="상태" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>

        </Canvas>

        <Border Grid.Row="2" Margin="5,10,5,5" BorderBrush="Black" BorderThickness="1,1,1,1" Background="WhiteSmoke" Focusable="False">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" x:Name="sv" >

                <ItemsControl x:Name="ic" Grid.Row="3" Focusable="False"  AlternationCount="10000" >
                    <ItemsControl.ItemsPanel >
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Focusable="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate >
                        <DataTemplate>
                            <Canvas Height="77.8" PreviewMouseLeftButtonDown="Canvas_PreviewMouseDown" Background="{Binding icback}"  Focusable="False" >
                                <TextBlock Canvas.Left="0" Canvas.Top="28" FontSize="18" Width="55" Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},
                                      Path=(ItemsControl.AlternationIndex),Converter={StaticResource IndexConverte}}" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="0" Canvas.Top="8" FontSize="18" Width="55" Text="{Binding urgency,Converter={StaticResource StrConverte}}" Foreground="Red" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="0" Canvas.Top="53" FontSize="18" Width="55" Text="{Binding pAccount}" Foreground="Blue" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>

                                <Border Canvas.Left="55" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Visibility="{Binding visibility}" FontWeight="Bold" Foreground="Green"  Canvas.Left="70" Width="300" Canvas.Top="6" FontSize="17" Text="{Binding orderDate}" ></TextBlock>

                                <TextBlock Foreground="Black" Canvas.Left="{Binding left}" Width="300" Canvas.Top="11" FontSize="15" Text="{Binding customSName}" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                <TextBlock Canvas.Left="70" Canvas.Top="43" FontSize="16" Text="{Binding prodName}" Width="310" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="375" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <!-- <TextBlock Canvas.Left="380" Canvas.Top="28" FontSize="18" Width="41" TextAlignment="Center" Text="{Binding paperGor}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>!-->
                                <!-- <Border Canvas.Left="425" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>!-->
                                <TextBlock Canvas.Left="380" Canvas.Top="2" FontSize="17"  Width="132" TextAlignment="Left" Text="{Binding aLaW}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="380" Canvas.Top="20" FontSize="17"  Width="132" TextAlignment="Left" Text="{Binding paperGor}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>

                                <TextBlock Margin="0,0,0,0" Canvas.Left="380" Foreground= "Blue" Canvas.Top="38" FontSize="17"  Width="112" TextAlignment="Left" Text="{Binding WDBJCount}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Margin="0,0,0,0" Canvas.Left="380" Foreground= "Red " Canvas.Top="56" FontSize="17"  Width="112" TextAlignment="Left" Text="{Binding WDIGCount}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="505" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <!--<TextBlock Canvas.Left="662" Canvas.Top="25" FontSize="18" Text="공정" FontWeight="Bold"></TextBlock>-->

                                <Grid  Canvas.Left="510" Canvas.Top="2"  Width="191" Height="72"   Focusable="False" >

                                    <ItemsControl ItemsSource="{Binding subOb}" Canvas.Left="555" Canvas.Top="17"   Height="72"  Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate >
                                                <WrapPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch"></WrapPanel>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" BorderBrush="Black" Background="{Binding stateColor}"  Height="30" Margin="3,3,3,3" CornerRadius="5">
                                                    <TextBlock Text="{Binding ProcessTypeName}"  Foreground="{Binding stateFontColor}" HorizontalAlignment="Center" FontFamily="/font/#KoPubDotum Medium" VerticalAlignment="Center" FontSize="17" Padding="5,0,5,0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Border Canvas.Left="745" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <!--<TextBlock Canvas.Left="755" Canvas.Top="11" FontSize="18" Text="색도" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>-->
                                <TextBlock Canvas.Left="833" Canvas.Top="1" FontSize="15"  Text="{Binding item1}" Foreground="Green"  Width="170"  FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="833" Canvas.Top="20" FontSize="15" Text="{Binding item2}" Foreground="Black"  Width="170"  FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="833" Canvas.Top="40" FontSize="15" Text="{Binding item3}" Foreground="Green"  Width="170"  FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="833" Canvas.Top="60" FontSize="15" Text="{Binding item4}" Foreground="Black"  Width="170"  FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border    Canvas.Left="1010" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                
                                <TextBlock Canvas.Left="984" Canvas.Top="28" FontSize="15" Width="80" Text="{Binding pplanCount}" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="1070" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Canvas.Left="1040" Canvas.Top="18" FontSize="15" Width="75" Text="{Binding presultCount}" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="1040" Canvas.Top="38" FontSize="15" Width="75" Text="{Binding perrorCount}" Foreground="red" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="1125" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <Image Canvas.Left="1130" Canvas.Top="2" Width="130" Height="73" Source="{Binding imagePath}" PreviewMouseLeftButtonDown="Image_MouseDown"></Image>
                                <Border BorderBrush="#2c3e50" BorderThickness="0,0,0,1" Width="1300" Canvas.Bottom="0"></Border>

                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="txtNoPlan" Text="생산계획이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="35" Grid.Row="2" FontFamily="/font/#KoPubDotum Medium" Margin="471,329,471,501"></TextBlock>
        <Canvas x:Name="can" Background="Black" Opacity="0.35" Grid.RowSpan="3" Visibility="Collapsed">

        </Canvas>
        <TextBox x:Name="tbBarcode" Text="" HorizontalAlignment="Left" Width="200" Height="50" Visibility="Visible" Opacity="0" KeyDown="TbBarcode_KeyDown"></TextBox>

    </Grid>
</UserControl>
