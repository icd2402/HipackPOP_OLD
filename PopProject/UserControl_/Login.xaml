<UserControl x:Class="PopProject.UserControl_.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PopProject.UserControl_"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1280" KeyDown="Login_keydownEvent">
    <Grid x:Name="Grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="5.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/img/back_02.png"/>
        </Grid.Background>

        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Canvas Height="250"></Canvas>
            <TextBlock Text="안녕하세요" FontSize="50" Padding="40,0,0,0" FontWeight="Bold" Foreground="White" MouseLeftButtonDown="Login_MouseLeftButtonDown" ></TextBlock>
            <Canvas Height="150"></Canvas>
            <TextBlock Text="프로그램의 문의사항은 아래의 정보로 연락주시기 바랍니다." FontSize="19" Padding="40,0,0,0" FontWeight="Bold" Foreground="White" Margin="0,0,0,50"></TextBlock>
            <TextBlock Text="A. 부산시 남구 자성로 152 한일 O/T 1001호" FontSize="19" Padding="40,0,0,0" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"></TextBlock>
            <TextBlock Text="T. 051-466-2402 / 0507-519-1235" FontSize="19" Padding="40,0,0,0" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" ></TextBlock>
            <TextBlock Text="S. www.packcom.co.kr" FontSize="19" Padding="40,0,0,0" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" ></TextBlock>
            
        </StackPanel>

        <StackPanel Grid.Column="1">

            <Canvas Height="200"/>
            
            <Canvas Height="650" Background="White" Opacity="0.2" Margin="20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

        </StackPanel>

        <StackPanel Grid.Column="1">

            <Canvas Height="200"/>
            <Canvas Height="650"  Margin="20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" Height="650" Width="664">

                    <TextBlock Text="사용자 아이디" FontSize="25" Padding="10,0,0,0" FontWeight="Bold" Foreground="Black" Margin="20,100,0,0"></TextBlock>
                    <TextBox x:Name="textbox_login_id" Margin="20,20,50,0" Height="60" Opacity="0.5" FontSize="30" Foreground="Black" Padding="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Focusable="True"></TextBox>

                    <TextBlock Text="사용자 비밀번호" FontSize="25" Padding="10,0,0,0" FontWeight="Bold" Foreground="Black" Margin="20,20,0,0"></TextBlock>
                    <PasswordBox  x:Name="textbox_login_password" Margin="20,20,50,0" Height="60" Opacity="0.5" FontSize="30"  Foreground="Black" Padding="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" KeyDown="Textbox_login_password_KeyDown"></PasswordBox>

                    <Viewbox Height="38" HorizontalAlignment="Left" Margin="20">
                        <CheckBox Content=" 자동 로그인"  FontSize="11"  x:Name="login_check" />
                    </Viewbox>

                    <TextBlock MouseLeftButtonDown="Login_button_MouseLeftButtonDown" x:Name="login_button" Text="로그인" FontSize="30" Height="70" Margin="20,30,20,0" Background="#f49440" TextAlignment="Center" Padding="0,15,0,0" MouseEnter="Login_button_MouseEnter" MouseLeave="Login_button_MouseLeave"></TextBlock>
                    <TextBlock MouseLeftButtonDown="Exit_button_MouseLeftButtonDown" x:Name="Exit_button" Text="종료" FontSize="30" Height="70" Margin="20,30,20,0" Background="#f49440" TextAlignment="Center" Padding="0,15,0,0" MouseEnter="Exit_button_MouseEnter" MouseLeave="Exit_button_MouseLeave" ></TextBlock>
               
                </StackPanel>

            </Canvas>

        </StackPanel>
        <Canvas x:Name="can" Background="Black" Opacity="0.35" Grid.ColumnSpan="2" Visibility="Collapsed">

        </Canvas>
    </Grid>


</UserControl>
