<Window x:Class="PopProject.UserControl_.UserSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.UserControl_"
        mc:Ignorable="d"
        Title="UserSetting"  Height="750" Width="450" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True">
    <Border BorderThickness="1" BorderBrush="Black">
        <Canvas Margin="-1,0,0,1">
            <Image Source="/img/back_03-1.png" Stretch="Fill" Canvas.Left="-1" Width="450" Height="60" MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
            <Image Source="/img/out_02.png" Canvas.Left="395" Canvas.Top="7" MouseDown="Exit_window" Height="45" Width="45"/>

            <Button x:Name="sendButton" Canvas.Top="7" Canvas.Left="265" Width="120" Height="45" Content="사용자 추가" FontSize="20" FontWeight="Bold" Foreground="White" Click="User_Add" Background="Gray">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Canvas Canvas.Top="60" Width="440" Height="40"  Background="WhiteSmoke" Opacity="0.5" Margin="5,0,5,5"/>
            <TextBlock   Canvas.Left="60" Canvas.Top="72" FontSize="16" Text="ID" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock   Canvas.Left="168" Canvas.Top="72" FontSize="16" Text="사용자명" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock   Canvas.Left="300" Canvas.Top="72" FontSize="16" Text="최근 로그인 시간" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <Border BorderBrush="#2c3e50" Canvas.Top="104" BorderThickness="0,0,0,1" Width="449" Canvas.Bottom="0"></Border>
            <ScrollViewer Width="440" Height="637" Canvas.Top="100" VerticalScrollBarVisibility="Disabled" Background="WhiteSmoke" Margin="5,5,5,5" BorderBrush="Black" BorderThickness="1">
                <ItemsControl x:Name="ic" Focusable="False"  AlternationCount="10000" >
                <ItemsControl.ItemsPanel >
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Focusable="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate  >
                    <DataTemplate x:Name="dt" >
                        <Canvas  Height="50" PreviewMouseLeftButtonDown="Canvas_PreviewMouseDown" Background="{Binding icback}"  Focusable="False" >

                                
                            
                            <TextBlock Canvas.Left="5" Canvas.Top="15" FontSize="16"  Width="120" Text="{Binding login_id}" Foreground="Black" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                            <Border Canvas.Left="130" Width="1" Height="50" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Canvas.Left="135" Canvas.Top="15" FontSize="16"  Width="120" Text="{Binding user_name}"  Foreground="Black" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                            <Border Canvas.Left="260" Width="1" Height="50" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                            <TextBlock Canvas.Left="270" Canvas.Top="15" FontSize="16"  Width="170" Text="{Binding login_time}"  Foreground="Black" TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>




                                <Border BorderBrush="#2c3e50" BorderThickness="0,0,0,1" Width="449" Canvas.Bottom="0"></Border>


                            </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Canvas>

       
    </Border>
</Window>
