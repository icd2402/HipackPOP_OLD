<Window x:Class="PopProject.UserControl_.AuthCode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.UserControl_"
        mc:Ignorable="d"
        Title="AuthCode" Height="110" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"  >

    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5">
        <Canvas MouseLeftButtonDown="Image_MouseDown">
            <Border Background="Black"  Height="31" Width="348"/>
            <Image Source="/img/out_02.png" Canvas.Left="313" Canvas.Top="2" MouseDown="Image_MouseDown_1" Height="27" Width="35"/>
            <Label Content="비밀번호" FontSize="15" Foreground="White" Height="29" Width="73" Canvas.Top="1" Canvas.Left="13" MouseLeftButtonDown="Label_MouseLeftButtonDown" />
            <!--<Label Content="비밀번호" Height="28" HorizontalAlignment="Left"  VerticalAlignment="Top" Canvas.Left="20" Canvas.Top="36" FontWeight="Bold" />-->
            <!--<Label Content="설비 선택" Height="28" HorizontalAlignment="Left"  VerticalAlignment="Top" Canvas.Left="86" Canvas.Top="36" FontWeight="Bold" />
        <TextBlock x:Name="tbMercName" Text="공 정 선 택" TextAlignment="Center" Width="200" Foreground="Black"  FontSize="22" Canvas.Top="70" Canvas.Left="20"   MouseLeftButtonDown="Mer_click"></TextBlock>-->
            <PasswordBox  x:Name="authCode" FontSize="20" Width="238" Canvas.Left="20" Canvas.Top="53" Height="34" />

            <Button  Width="59" Height="34" Canvas.Top="53" Canvas.Left="275" Content="확인" FontSize="14" FontWeight="Bold" Foreground="White" Background="DarkOrange" Click="AuthCodeSave">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>

            </Button>
        </Canvas>

    </Border>


</Window>
