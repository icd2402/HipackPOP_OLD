<Window x:Class="PopProject.UserControl_.ChangeWorkList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PopProject.UserControl_"
        mc:Ignorable="d"
        Title="ChangeWorkList" Height="900" Width="1280" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" MouseLeftButtonDown="Drag">

    <Window.Resources>
        <local:indexConvert x:Key="indexConvert"></local:indexConvert>
    </Window.Resources>
    <Grid Width="1280" Height="900">
        <Grid.Background>
            <ImageBrush ImageSource="/img/back_05.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>

        <TextBlock  Name="tbMercName" Text="공정" Foreground="White" FontSize="33"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,30,0,0" FontFamily="/font/#KoPubDotum Bold" ></TextBlock>
        <TextBlock  x:Name="Topup" Text="맨위로" Background="DimGray" Padding="10"  Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="360,25,0,0" MouseLeftButtonDown="TopUp_mouse"/>

        <TextBlock  x:Name="up" Text="위로" Background="DimGray" Padding="10"  Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="520,25,0,0" MouseLeftButtonDown="Up_mouse"/>
        <TextBlock  x:Name="down" Text="아래"  Background="DimGray" Padding="10" Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="660,25,0,0" MouseLeftButtonDown="Down_mouse"/>
        <TextBlock  x:Name="Topdown" Text="맨아래"  Background="DimGray" Padding="10" Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="820,25,0,0" MouseLeftButtonDown="TopDown_mouse"/>


        <TextBlock  x:Name="complete" Text="완료"  Background="DimGray" Padding="10" Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="1000,25,0,0" MouseLeftButtonDown="Complete_mouse"/>
        <TextBlock   Text="닫기"  Background="DimGray" Padding="10" Foreground="White" FontSize="25" FontFamily="/font/#KoPubDotum Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="1200,25,0,0" MouseLeftButtonDown="Exit_mouse"/>

        <TextBlock  Text="생산계획순서변경" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,30,0,0" ></TextBlock>
        <Canvas Grid.Row="1" Background="White" Opacity="0.5">
        </Canvas>
        <Canvas x:Name="can1" Grid.Row="1" Margin="10,0,10,0">
            <Image Width="40" Height="40" Canvas.Left="8" Source="/img/title_01.png"/>
            <TextBlock x:Name="tbNo" Text="NO" TextAlignment="Center" Width="30" Canvas.Top="11" FontSize="18" Canvas.Left="14" FontWeight="Bold" Foreground="White" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock x:Name="div"  Canvas.Left="163" Canvas.Top="10" FontSize="18" Text="거래처/품명" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold" MouseLeftButtonDown="Select_prod"/>
            <!--<TextBlock Canvas.Left="390" Canvas.Top="10" FontSize="18" Text="골" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>!-->
            <TextBlock Canvas.Left="460" Canvas.Top="10" FontSize="18" Text="공정" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="620" Canvas.Top="10" FontSize="18" Text="원단정보" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>

            <TextBlock Canvas.Left="745" Canvas.Top="10" FontSize="18" Text="계획" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="815" Canvas.Top="10" FontSize="18" Text="결과" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="965" Canvas.Top="10" FontSize="18" Text="작업정보" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
            <TextBlock Canvas.Left="1168" Canvas.Top="10" FontSize="18" Text="상태" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"/>
              
        </Canvas>
        <Border Grid.Row="2" Margin="5,10,5,5" BorderBrush="Black" BorderThickness="1,1,1,1" Background="WhiteSmoke" Focusable="False">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" x:Name="icsv" PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Sv_PreviewMouseLeftButtonUp" PreviewMouseMove="Sv_PreviewMouseMove">
                <ItemsControl x:Name="ic3" Grid.Row="3" Focusable="False"  AlternationCount="1000" >
                    <ItemsControl.ItemsPanel >
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Focusable="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate >
                        <DataTemplate>
                            <Canvas Height="77.8" PreviewMouseLeftButtonDown="Canvas_PreviewMouseDown" Background="{Binding icback}"  Focusable="False" >
                                <TextBlock Canvas.Left="5" Canvas.Top="28" FontSize="18" Width="55" Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},
                                      Path=(ItemsControl.AlternationIndex), Converter={StaticResource indexConvert}}"
                                     TextAlignment="Center" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="65" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Foreground="Black" Canvas.Left="75" Canvas.Top="11" FontSize="15" Text="{Binding customSName}" FontFamily="/font/#KoPubDotum Medium"></TextBlock>
                                <TextBlock Canvas.Left="75" Canvas.Top="43" FontSize="16" Text="{Binding prodName}" Width="310" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="375" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <!-- <TextBlock Canvas.Left="380" Canvas.Top="28" FontSize="18" Width="41" TextAlignment="Center" Text="{Binding paperGor}" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>!-->
                                <!-- <Border Canvas.Left="425" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>!-->
                                                                 <!--<TextBlock Canvas.Left="662" Canvas.Top="25" FontSize="18" Text="공정" FontWeight="Bold"></TextBlock>-->
                                <Grid  Canvas.Left="380" Canvas.Top="2"  Width="191" Height="72"   Focusable="False" >
                                    <ItemsControl ItemsSource="{Binding subOb}"  Canvas.Left="555" Canvas.Top="17"   Height="72"  Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate >
                                                <WrapPanel VerticalAlignment="Stretch"  HorizontalAlignment="Stretch"></WrapPanel>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1"  BorderBrush="Black" Background="{Binding stateColor}"  Height="30" Margin="3,3,3,3" CornerRadius="5">
                                                    <TextBlock Text="{Binding ProcessTypeName}"  Foreground="{Binding stateFontColor}" HorizontalAlignment="Center" FontFamily="/font/#KoPubDotum Medium" VerticalAlignment="Center" FontSize="17" Padding="5,0,5,0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <Border Canvas.Left="580" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Canvas.Left="585"  Canvas.Top="5"  FontSize="16" Width="140" Text="{Binding aLaW}" TextAlignment="Left" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>

                                <TextBlock Canvas.Left="585"  Canvas.Top="28"  FontSize="16" Width="140" Text="{Binding paperGor}" TextAlignment="Left" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="585" Foreground="Red"  Canvas.Top="50"  FontSize="16" Width="140" Text="{Binding WDIGCount1}" TextAlignment="Left" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>




                                <Border Canvas.Left="730" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                               
                                <TextBlock Canvas.Left="738" Canvas.Top="28"  FontSize="15" Width="55" Text="{Binding pplanCount}" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="801" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>

                                <Border BorderBrush="#2c3e50" BorderThickness="0,0,0,1" Width="1280" Canvas.Bottom="0"></Border>
                                <TextBlock Canvas.Left="810" Canvas.Top="18"  FontSize="15" Width="55" Text="{Binding sumPworkCount}" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="810" Canvas.Top="38"  FontSize="15" Width="55" Text="{Binding perrorCount}" Foreground="red" TextAlignment="Right" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="870" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <TextBlock Canvas.Left="880" Canvas.Top="5" FontSize="13"   Text="{Binding item4}" Width="240" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="880" Canvas.Top="29" FontSize="13"  Text="{Binding item5}" Width="240" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <TextBlock Canvas.Left="880" Canvas.Top="53" FontSize="13"  Text="{Binding item6}" Width="240" FontWeight="Bold" FontFamily="/font/#KoPubDotum Bold"></TextBlock>
                                <Border Canvas.Left="1125" Width="1" Height="76.5" BorderBrush="#2c3e50" BorderThickness="0,0,1,0"></Border>
                                <Image Canvas.Left="1130" Canvas.Top="2" Width="130" Height="73" Source="{Binding imagePath}" ></Image>

                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="txtNoPlan" Text="생산계획이 없습니다." HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" FontSize="35"  FontFamily="/font/#KoPubDotum Medium" Margin="471,300,471,501"></TextBlock>

    </Grid>
    
</Window>
